# HOSTNAME=localhost
# HOST=localhost # alias for HOSTNAME (README compatibility)
# PORT=3000

# API_KEY=tDlSpNFZsGTrGUNHr0vzmICKarkOiPMc # Enables Authentication if an API Key is specified (to be passed)
# MEMOIZATION_TTL=30 # The maximum time (in minutes) to memoize successful requests.
# CUSTOM_X_HEADER=custom-header

# CORS_ORIGIN=http://localhost:8000

# CACHE_NEGATIVE_TTL=2 # Cache failed lookups for N minutes (0 disables)
# CACHE_DIR=~/.cache/livetube # Shared cache root: yt-dlp --cache-dir + persistent redb database
# CACHE_REDIS_URL= # e.g. redis://localhost:6379/0 — shared cache across instances (overrides redb)

# YTDLP_JS_RUNTIME=bun:/usr/local/bin/bun # --js-runtimes for yt-dlp (auto-detected)
# YTDLP_TIMEOUT=120 # Kill yt-dlp after N seconds (0 = disabled)
# REQUEST_TIMEOUT=30 # Timeout for stream validation requests (0 = disabled)
